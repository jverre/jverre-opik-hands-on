{
  "name": "langchainjs-board-game-rules-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rules-helper chat widget for a fictional board-game cafe, built with LangChain.js and Express.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "demo": "tsx src/demo.ts",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@langchain/core": "^1.1.0",
    "@langchain/openai": "^1.2.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "opik": "2.3.2",
    "opik-langchain": "2.3.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "opik-langchain": {
      "opik": "$opik"
    }
  }
}
