# Model provider key (required for `npm run demo` / `npm run dev`).
OPENAI_API_KEY=

# Opik (added in the tracing step). Defaults below target a local Opik install.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# For Opik Cloud instead: unset OPIK_URL_OVERRIDE and set OPIK_API_KEY=
OPIK_API_KEY=
