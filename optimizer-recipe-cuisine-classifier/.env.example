# Copy to .env (or reuse a .env at the repo root; this example walks up to find it).

# --- Opik (local self-hosted) ---
# Start Opik locally: https://www.comet.com/docs/opik/self-host/local_deployment
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# For Opik Cloud, set OPIK_API_KEY and change the URL; a local Opik needs no key.
# OPIK_API_KEY=

# --- LLM provider ---
# gpt-4o-mini classifies the dishes and also acts as the optimizer's reasoning model.
OPENAI_API_KEY=
