# This example reads the repo-root .env (one level up). Variables it uses:

# Opik base URL. setup.sh turns it into the OTLP endpoint the n8n container exports to
# (localhost becomes host.docker.internal). Local Opik: https://www.comet.com/docs/opik/self-host/local_deployment
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# Only for Opik Cloud (then also set OPIK_URL_OVERRIDE=https://www.comet.com/opik/api/):
# OPIK_API_KEY=

# The screening node calls gpt-4o-mini: https://platform.openai.com/api-keys
OPENAI_API_KEY=
