{
  "name": "openai-ts-vet-voicemail-triage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Voicemail triage for a fictional vet clinic: TTS audio, transcription, urgency and callback list, traced in Opik.",
  "engines": { "node": ">=20" },
  "scripts": {
    "demo": "tsx src/demo.ts",
    "suite": "tsx src/suite.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openai": "6.49.0",
    "opik": "2.3.2",
    "opik-openai": "2.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "opik-openai": { "opik": "$opik" }
  }
}
