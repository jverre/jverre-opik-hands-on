# Copy to .env (or keep these in a .env at the repo root; main.py looks in both places).
OPENAI_API_KEY=your-openai-key

# Opik: the defaults below point at a local self-hosted install.
# For Opik Cloud, drop OPIK_URL_OVERRIDE and set OPIK_API_KEY + your workspace instead.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# OPIK_API_KEY=
