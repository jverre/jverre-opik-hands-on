# Copy this file to .env at the repo root and fill in your values.
# Every example walks up to the repo root to find this .env, so you only fill it in once.

# --- Opik ---
# Local Opik (default): https://www.comet.com/docs/opik/self-host/local_deployment
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# Opik Cloud instead: set OPIK_URL_OVERRIDE=https://www.comet.com/opik/api/, your workspace, and an API key.
# OPIK_API_KEY=
# Each example logs to its own Opik project named after its folder; do not set OPIK_PROJECT_NAME here.

# --- LLM provider ---
# Used by every example except ollama-homebrew-rag: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Optional, per example ---
# ollama-homebrew-rag: where Ollama listens
# OLLAMA_URL=http://localhost:11434
# vercel-ai-bike-repair-chat: port for the demo's temporary server
# DEMO_PORT=4191
# dify-climbing-gym-assistant: host port for Dify's UI and API
# DIFY_PORT=8090
