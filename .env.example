# Copy this file to .env at the repo root and fill in your values.
# Every example walks up to the repo root to find this .env, so you only fill it in once.

# --- Opik (local self-hosted) ---
# Start Opik locally: https://www.comet.com/docs/opik/self-host/local_deployment
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# OPIK_API_KEY is not needed for a local Opik. Set it (and change the URL) only for Opik Cloud.
# OPIK_API_KEY=

# --- LLM providers ---
# Required by most examples: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional, used only by examples that call Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
