# Copy to .env (or reuse a repo-root .env; the demo loads both).
OPENAI_API_KEY=

# Opik, local self-hosted by default: https://www.comet.com/docs/opik/self-host/local_deployment
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# Only for Opik Cloud (and change OPIK_URL_OVERRIDE to https://www.comet.com/opik/api):
# OPIK_API_KEY=
