# This example reads the repo-root .env (one level up). Variables it uses:

# The app's model calls go to gpt-4o-mini: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: the host port for Dify's UI and API (default 8090)
# DIFY_PORT=8090

# Opik. Dify's built-in Opik tracing sends every chat message here.
# Local Opik: https://www.comet.com/docs/opik/self-host/local_deployment
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# Only for Opik Cloud (then OPIK_URL_OVERRIDE=https://www.comet.com/opik/api/):
# OPIK_API_KEY=
