# Provider key for the detection step (leave empty here; put the real value in .env)
OPENAI_API_KEY=

# Opik: the defaults below are for a local self-hosted stack.
# For Opik Cloud, set OPIK_API_KEY and OPIK_WORKSPACE instead and drop the URL.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
OPIK_PROJECT_NAME=opik-py-redaction-pipeline
