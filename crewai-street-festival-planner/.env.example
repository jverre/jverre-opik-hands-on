# Copy to .env (here or in any parent folder) and fill in.
OPENAI_API_KEY=

# Local self-hosted Opik. Leave these as they are for the standard local install.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# For Opik Cloud, set OPIK_API_KEY and change the URL instead.
# OPIK_API_KEY=
