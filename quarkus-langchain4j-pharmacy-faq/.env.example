# Copy to .env (or reuse the repo-root .env). run.sh loads ../.env then ./.env.
OPENAI_API_KEY=

# Local self-hosted Opik. The OTLP endpoint is derived from OPIK_URL_OVERRIDE.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# Opik Cloud only: set OPIK_API_KEY and OPIK_OTEL_ENDPOINT=https://www.comet.com/opik/api/v1/private/otel
# OPIK_API_KEY=
